# Template for .env (copy to .env, which is git-ignored). Nothing here is a secret; every variable has a built-in default.
# Loaded by Next.js (dev/build/start) and by the sync scripts (npm run fetch / images / videos).

# Old WordPress site. Only the sync scripts (fetch, images, videos) and the old-link rewrite use it.
WP_URL=https://ramadan.islamonlive.in

# Public address of THIS site (no trailing slash), e.g. https://ramadan.islamonlive.in after cutover.
# Used for absolute URLs in page metadata. Fill in before deploying. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://ramadan.islamonlive.in

# Link behind the Thafheem ul Quran banner and ads.
NEXT_PUBLIC_APP_URL=https://app.thafheem.net/

# Public base URL of the R2 bucket serving /uploads images (no trailing slash), e.g. https://media.ramadan.islamonlive.in
# Fill in after enabling public access on the bucket (custom domain recommended). Empty = images served from this site.
NEXT_PUBLIC_MEDIA_URL=

# R2 bucket, used only by `npm run r2:upload` (S3-compatible keys from Cloudflare > R2 > Manage API tokens). SECRET.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Content database behind /admin and the pages: Cloudflare D1, read through its HTTP API (set the same on Vercel).
# The token only needs D1 Edit. SECRET.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

# /admin login password. On Vercel: vercel env add ADMIN_PASSWORD production (then redeploy). SECRET.
ADMIN_PASSWORD=
